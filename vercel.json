{
  "rewrites": [
    { "source": "/send-order", "destination": "/api/send-order" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" }] },
    { "source": "/admin/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" }] },
    { "source": "/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" }] }
  ]
}
